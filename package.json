{
  "name": "npm-supply-chain-audit",
  "version": "0.0.0",
  "private": true,
  "description": "A browser-based supply-chain audit tool for npm organizations: trusted-publishing/provenance rollout, manual publishes, and external maintainers.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build:analyze": "rm -rf .sonda/ && SONDA=true vite build",
    "dev": "vite",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "knip": "knip",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "preview": "vite preview",
    "test": "pnpm run test:unit && pnpm run test:database && pnpm run typecheck && pnpm run format:check && pnpm run lint",
    "test:a11y": "playwright test",
    "test:coverage": "vitest run --coverage --maxWorkers=1",
    "test:database": "vitest run netlify/tests/functions --maxWorkers=1",
    "test:unit": "vitest run --exclude 'netlify/tests/functions/**'",
    "test:unit:watch": "vitest",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --tsgo"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@lucide/svelte": "^1.22.0",
    "@netlify/database": "^1.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "packumeta": "0.4.1",
    "svelte": "^5.56.4",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@e18e/eslint-plugin": "^0.5.1",
    "@netlify/database-dev": "^0.10.1",
    "@netlify/edge-functions": "^3.0.8",
    "@netlify/functions": "^5.3.0",
    "@netlify/vite-plugin": "^2.12.9",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.0.1",
    "@typescript/native-preview": "7.0.0-dev.20260629.1",
    "@vitest/coverage-v8": "4.1.9",
    "jsdom": "^29.1.1",
    "knip": "^6.23.0",
    "oxfmt": "^0.57.0",
    "oxlint": "^1.72.0",
    "sonda": "^0.13.1",
    "svelte-check": "^4.7.1",
    "typescript": "6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.9"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": ">=26.0.0",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
